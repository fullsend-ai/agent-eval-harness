{
  "name": "agent-eval-harness",
  "version": "1.56.2",
  "description": "Agent and skill evaluation harness with MLflow integration",
  "author": {
    "name": "fullsend-ai"
  },
  "homepage": "https://github.com/fullsend-ai/agent-eval-harness",
  "repository": "https://github.com/fullsend-ai/agent-eval-harness",
  "license": "Apache-2.0",
  "keywords": [
    "evaluation",
    "testing",
    "skills",
    "agents",
    "mlflow"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure_deps.py\" \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/eval_stop_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
